lerna-debug.log*

# Environment
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Local data (SQLite + uploads — see PRD §3)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
public/uploads/*
!public/uploads/.gitkeep
# Seed assets ARE checked in (they're project content, not user uploads)
!public/uploads/seed/
!public/uploads/seed/**

# OS noise
.DS_Store
Thumbs.db
*~

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# Local agent / tool working state (not part of the project)
cache/
jobs/
snapshots/
webhooks/

# Misc
.vercel
*.pem
