!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
